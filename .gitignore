# --- Secrets: never commit -------------------------------------------------
# The Gemini key is read from googleapikey.env at import time. Keep every
# .env out of the repo; commit a .env.example with blank values instead.
*.env
!*.env.example
googleapikey.env
*.key
*.pem
secrets.json
credentials.json

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Python bytecode -------------------------------------------------------
# NOTE: .pyc files already committed stay tracked until `git rm -r --cached`.
# They embed string literals from the source, so a key that was once
# hardcoded survives in the compiled file even after the source is cleaned.
__pycache__/
*.py[cod]
*$py.class

# --- Runtime output --------------------------------------------------------
# Verifier run store: holds full copies of scraped third-party pages.
runs/
# Screenshots written by the app at request time.
static/*_screenshot.png

# --- Tooling / test artifacts ----------------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Editor / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
