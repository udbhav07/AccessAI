# Copy to backend/.env. All settings are optional.

# From https://aistudio.google.com/apikey. Without it, a deterministic fallback is used.
# (GEMAPI is also accepted, for older deployments.)
GEMINI_API_KEY=

# GEMINI_MODEL=gemini-3.6-flash

# Must include the deployed frontend's URL in production.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per caller, per worker process.
# SCANS_PER_HOUR=20
# VERIFICATIONS_PER_HOUR=30

# Reverse proxies in front of the app (1 on Render, 0 locally).
# TRUSTED_PROXIES=0

# Defaults to backend/runs.
# RUNS_DIR=

# Never enable on a deployment.
# FLASK_DEBUG=0
